# A brand for tools/build-dmg.sh --brand=brands/<name>.env: a personalized
# JobDesk.dmg for one person. Copy this file; brands/*.env other than this
# example are git-ignored (they're personal).
#
# Plain shell assignments. Keep names free of " ' ` \ $ < > { } (they end up
# in code); use a curly ’ for apostrophes.

# The app's name everywhere: the app, the web UI, the setup window.
BRAND_NAME="Sam’s Job Search"
# The disk image's name (short).
BRAND_VOLUME="Sam’s Job Search"
# Their folder in the home folder, for their CV, tracker and PDFs.
BRAND_DATA_DIR="Job Applications"
# The hint in the empty CV box.
BRAND_CV_PLACEHOLDER="Paste your resume here, or drop the PDF"
# From "Read my CV" to the first results: [line, seconds shown]. A last line
# with null stays up until the results are ready; then BRAND_FUN_REVEAL shows
# for BRAND_FUN_REVEAL_SECONDS and the results appear.
BRAND_FUN_LINES='[["On it!", 2], ["reading your resume…", 3], ["searching", null]]'
BRAND_FUN_REVEAL="👀"
BRAND_FUN_REVEAL_SECONDS=2
# Who made it, for the picture guide's footer.
BRAND_FROM="a friend"

# A brand for tools/build-dmg.sh --brand=brands/<name>.env: a personalized
# JobDesk.dmg for one person. Copy this file; brands/*.env other than this
# example are git-ignored (they're personal).
#
# Plain shell assignments. Keep names free of " ' ` \ $ < > { } (they end up
# in code); use a curly ’ for apostrophes.

# The app's name everywhere: the app, the web UI, the setup window.
BRAND_NAME="Sam’s Job Search"
# The disk image's name (short).
BRAND_VOLUME="Sam’s Job Search"
# Their folder in the home folder, for their CV, tracker and PDFs.
BRAND_DATA_DIR="Job Applications"
# The hint in the empty CV box.
BRAND_CV_PLACEHOLDER="Paste your resume here, or drop the PDF"
# From "Read my CV" to the first results: [line, seconds shown]. A last line
# with null stays up until the results are ready; then BRAND_FUN_REVEAL shows
# for BRAND_FUN_REVEAL_SECONDS and the results appear.
BRAND_FUN_LINES='[["On it!", 2], ["reading your resume…", 3], ["searching", null]]'
# Lines that get growing dots while shown ("searching." → ".." → "...").
BRAND_FUN_DOTS='["searching"]'
BRAND_FUN_REVEAL="👀"
BRAND_FUN_REVEAL_SECONDS=2
# Who made it, for the picture guide's footer.
BRAND_FROM="a friend"
# The Claude model for every AI step (scoring, tailoring, reading resumes).
# claude-sonnet-5-5 costs about half of Claude Code's default.
BRAND_MODEL="claude-sonnet-5-5"
# Optional decoration. "howl": original drawings in a Ghibli-afternoon spirit
# (a walking patchwork castle on the loading bar, a hearth flame, a sky with
# clouds or stars behind each page, a flower meadow in the sidebar). Empty for none.
BRAND_THEME=""
# A line of encouragement from whoever made it, shown once, with confetti,
# when they send their very first application. Empty for none.
BRAND_CHEER=""
# A picture under the menu, path relative to the repository (keep it in
# brands/, which git ignores apart from this example). Empty for none.
BRAND_ART=""
# In-app updates (tools/publish-update.sh publishes; the app shows "A new
# version is ready"). Needs a read-only GitHub token for the repository in the
# Keychain under jobdesk-update-token. Empty for none.
BRAND_UPDATE_REPO=""
BRAND_UPDATE_CHANNEL=""
# The app's icon: a 1024 px PNG (the Mac icon, the logo in the app and its
# tab icon). Empty for JobDesk's.
BRAND_ICON=""
# The assistant's name (its panel and how it introduces itself). Empty for
# "the <app name> assistant".
BRAND_ASSISTANT=""
# The assistant's first sentence in its panel. Empty for "Hi — I'm your <app> assistant."
BRAND_ASSISTANT_HELLO=""

# A song that plays once when a resume is uploaded (the loading screen): an
# audio file you own (.m4a/.mp3/.aac/.wav), copied into the build. Optional:
# BRAND_MUSIC_CLIP picks a part in seconds (start-end), BRAND_MUSIC_TITLE is
# the name on its stop button.
# BRAND_MUSIC="brands/song.m4a"
# BRAND_MUSIC_CLIP="62-128"
# BRAND_MUSIC_TITLE="Our song"
